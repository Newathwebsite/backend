# Get this from https://console.anthropic.com/ — keep it server-side only,
# never put it in the React app's .env (those get bundled into client JS).
ANTHROPIC_API_KEY=

# Optional shared token the admin panel sends with each AI request. Set the
# same value here and in ath-react-site/.env as VITE_ADMIN_PROXY_TOKEN. This
# is a deterrent against outside abuse, not real security — see server.js.
ADMIN_PROXY_TOKEN=

# Comma-separated list of origins allowed to call this API — the public
# site's origin AND the admin subdomain's origin both need to be listed,
# e.g. https://assettreehomes.com,https://admin.assettreehomes.com
ALLOWED_ORIGIN=http://localhost:5174,http://localhost:5175

PORT=8787

# Real content database (SQLite — a single file, easy to back up. Point
# this at an absolute path in production so it survives redeploys).
DATABASE_URL="file:./dev.db"

# Signs the admin login JWT — generate your own random value, never reuse
# this or any other example value in production:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Web Push (real browser/phone notifications). Generate a pair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
