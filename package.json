{
  "name": "ath-ai-server",
  "version": "1.0.0",
  "description": "Backend for the ATH CMS: proxies Claude for AI-assisted SEO/blog/script writing, and sends real Web Push notifications triggered from Admin -> Push Notifications.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "prisma migrate deploy && node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "prisma": "^6.16.3",
    "web-push": "^3.6.7"
  }
}
